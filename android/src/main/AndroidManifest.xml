<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <application>
    <!-- Shows Dak's data messages with buttons (FCM cannot add buttons to
         the notifications it shows on Android). Like firebase_messaging's
         own receiver, it gets every FCM message and ignores the others. -->
    <receiver
      android:name="io.github.hridoyrocks.dak_push.DakMessagingReceiver"
      android:exported="true"
      android:permission="com.google.android.c2dm.permission.SEND">
      <intent-filter>
        <action android:name="com.google.android.c2dm.intent.RECEIVE" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
